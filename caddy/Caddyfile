# One public entry point for the production stack (docker-compose.prod.yml).
# SITE_ADDRESS is a domain (automatic HTTPS) or ":80" (plain HTTP, local testing).

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# The API and its health check go to the backend; everything else is the app.
	@api path /api/* /health
	handle @api {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format console
	}
}
