# Copy to .env. Never commit .env.

POSTGRES_DB=scenic
POSTGRES_USER=scenic
POSTGRES_PASSWORD=change-me
# Host port only. Uses a non-default port so it can't clash with a local Postgres.
POSTGRES_PORT=54320

# Any .osm.pbf URL (BBBike city extracts, Geofabrik regions).
# Each extract gets its own graph cache.
OSM_EXTRACT_URL=https://download.bbbike.org/osm/bbbike/Montreal/Montreal.osm.pbf
# Initial map view as lon,lat. Keep this inside the extract above.
MAP_CENTER=-73.6,45.52

GRAPHHOPPER_JAVA_OPTS=-Xmx2g

# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
